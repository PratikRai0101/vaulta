{
  "expo": {
    "name": "Vaulta",
    "slug": "vaulta",
    "scheme": "vaulta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111315",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaulta.wallet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your Vaulta wallet and approve access to protected wallet data."
      }
    },
    "android": {
      "package": "com.vaulta.wallet",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#111315",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Use Face ID to unlock your Vaulta wallet and approve access to protected wallet data."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your Vaulta wallet and approve access to protected wallet data."
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#111315",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#111315"
          }
        }
      ]
    ]
  }
}
